# Copy to .env.local; credentials stay server-side.
# Used when callers omit ?provider=ollama or ?provider=gemini.
DEFAULT_INFERENCE_PROVIDER=ollama
INFERENCE_FALLBACK_ENABLED=true
INFERENCE_CLIENT_DAILY_LIMIT=50

# Set the API key for each provider callers should be able to select.
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:cloud
OLLAMA_REQUESTS_PER_MINUTE=20
OLLAMA_CLIENT_REQUESTS_PER_MINUTE=5
OLLAMA_MAX_CONCURRENT=2

GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it
