# Copy to .env.local; credentials stay server-side.
# npm run dev:vercel serves the shared API on port 3001; app proxies run separately.
# Never prefix app secrets or provider credentials with VITE_ or NEXT_PUBLIC_.
# Requests require a provider query parameter and a model in the JSON body.
INFERENCE_FALLBACK_ENABLED=true
INFERENCE_CLIENT_DAILY_LIMIT=50
# Per-request total timeout in milliseconds; values above 170000 are capped.
INFERENCE_REQUEST_TIMEOUT_MS=120000
# Match the published Vercel @vercel/firewall rule ID inference-app's window.
# The rule owns the request count. This value supplies conservative Retry-After.
# Vercel POSTs fail closed if the rule/check is unavailable; local calls skip it.
INFERENCE_RATE_LIMIT_WINDOW_SECONDS=60

# Process-local Ollama limits apply across authenticated apps.
OLLAMA_REQUESTS_PER_MINUTE=20
OLLAMA_CLIENT_REQUESTS_PER_MINUTE=5
OLLAMA_MAX_CONCURRENT=2

# Optional service-wide Replit cap, including reasoning and the answer.
# Blank omits max_tokens and uses the gateway/upstream defaults.
# Invalid nonblank values disable Replit requests.
REPLIT_MAX_TOKENS=

# App secrets are shared only with their server-side proxies.
# Provider keys belong in the calling backends, never the shared deployment.
# Each request supplies its provider key in X-Inference-Provider-Key.
TRENDINGNOSTR_APP_SECRET=

ADVANCEDNOSTRSEARCH_APP_SECRET=

# Smoke caller only (never configure on the shared deployment):
# INFERENCE_SMOKE_PROVIDER_KEY=
# Protected deployment smoke only; set in the caller process environment:
# VERCEL_AUTOMATION_BYPASS_SECRET=
