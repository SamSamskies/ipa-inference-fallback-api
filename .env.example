# Copy to .env.local; credentials stay server-side.
# Used when callers omit the provider query parameter (ollama, gemini, or replit).
DEFAULT_INFERENCE_PROVIDER=replit
INFERENCE_FALLBACK_ENABLED=true
INFERENCE_CLIENT_DAILY_LIMIT=50
# Per-request total timeout in milliseconds; values above 170000 are capped.
INFERENCE_REQUEST_TIMEOUT_MS=120000

# Set the API key for each provider callers should be able to select.
# Models are required in request bodies and are configured in app backends.
OLLAMA_API_KEY=
OLLAMA_REQUESTS_PER_MINUTE=20
OLLAMA_CLIENT_REQUESTS_PER_MINUTE=5
OLLAMA_MAX_CONCURRENT=2

GEMINI_API_KEY=

# Your Replit gateway's bearer token.
REPLIT_API_KEY=
# Optional total completion-token cap, including reasoning. Blank uses gateway/model defaults.
REPLIT_MAX_TOKENS=

# App registry settings for authenticated routing (issue #5).
# These never fall back to the legacy global settings above or to another app.
# Keep app secrets in server-side proxies; provider keys only in the shared API.
TRENDINGNOSTR_APP_SECRET=
TRENDINGNOSTR_OLLAMA_API_KEY=
TRENDINGNOSTR_GEMINI_API_KEY=
TRENDINGNOSTR_REPLIT_API_KEY=
TRENDINGNOSTR_REPLIT_MAX_TOKENS=

ADVANCEDNOSTRSEARCH_APP_SECRET=
ADVANCEDNOSTRSEARCH_OLLAMA_API_KEY=
ADVANCEDNOSTRSEARCH_GEMINI_API_KEY=
ADVANCEDNOSTRSEARCH_REPLIT_API_KEY=
ADVANCEDNOSTRSEARCH_REPLIT_MAX_TOKENS=
