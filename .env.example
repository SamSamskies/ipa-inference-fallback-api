# Copy to .env.local; credentials stay server-side.
# Ollama Cloud is the default. Set INFERENCE_PROVIDER=gemini to use Gemini.
INFERENCE_PROVIDER=ollama
INFERENCE_FALLBACK_ENABLED=true
INFERENCE_CLIENT_DAILY_LIMIT=50

OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:cloud
OLLAMA_REQUESTS_PER_MINUTE=20
OLLAMA_CLIENT_REQUESTS_PER_MINUTE=5
OLLAMA_MAX_CONCURRENT=2

GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it

# Legacy Gemini aliases remain supported: INFERENCE_API_KEY,
# GEMINI_FALLBACK_ENABLED, GEMINI_CLIENT_DAILY_LIMIT.
# INFERENCE_MODEL is a model fallback only with explicit INFERENCE_PROVIDER.
